<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="AuthorizationWindow" parent="AdwWindow">
    <property name="modal">True</property>
    <property name="width-request">420</property>
    <property name="default-width">480</property>
    <property name="height-request">420</property>
    <property name="default-height">640</property>
    <property name="title" translatable="yes">Connection Request</property>
    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="vexpand">True</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="propagate-natural-height">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">18</property>
                <property name="margin-bottom">18</property>
                <child>
                  <object class="GtkLabel" id="peer">
                    <property name="label">An unauthorized device is trying to connect.</property>
                    <property name="width-request">100</property>
                    <property name="wrap">True</property>
                    <property name="wrap-mode">word-char</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Do you want to authorize it? Choose what the other device may do on this computer, and whether this computer may control it in return.</property>
                    <property name="width-request">100</property>
                    <property name="wrap">True</property>
                    <property name="wrap-mode">word-char</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Where is the other device?</property>
                    <property name="description" translatable="yes">Choose which side of this computer the connecting device is on.</property>
                    <child>
                      <object class="AdwComboRow" id="position">
                        <property name="title" translatable="yes">position</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Left</item>
                              <item>Right</item>
                              <item>Top</item>
                              <item>Bottom</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Can control this PC</property>
                    <property name="description" translatable="yes">What the device may do here after approval. All three are granted by default; uncheck what it must not do.</property>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Pointer</property>
                        <property name="subtitle" translatable="yes">move the cursor, click and drag</property>
                        <child>
                          <object class="GtkCheckButton" id="incoming_pointer">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Keyboard</property>
                        <property name="subtitle" translatable="yes">type and use keyboard shortcuts</property>
                        <child>
                          <object class="GtkCheckButton" id="incoming_keyboard">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Clipboard</property>
                        <property name="subtitle" translatable="yes">exchange clipboard contents</property>
                        <child>
                          <object class="GtkCheckButton" id="incoming_clipboard">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">This PC can control it</property>
                    <property name="description" translatable="yes">Whether this computer may send input to the other device. The device still enforces its own policy.</property>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Allow outgoing control</property>
                        <property name="subtitle" translatable="yes">turn off to grant control in one direction only</property>
                        <child>
                          <object class="GtkSwitch" id="outgoing_switch">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Pointer</property>
                        <child>
                          <object class="GtkCheckButton" id="outgoing_pointer">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Keyboard</property>
                        <child>
                          <object class="GtkCheckButton" id="outgoing_keyboard">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Clipboard</property>
                        <child>
                          <object class="GtkCheckButton" id="outgoing_clipboard">
                            <property name="active">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">sha256 fingerprint</property>
                    <child>
                      <object class="AdwActionRow">
                        <property name="child">
                          <object class="GtkLabel" id="fingerprint">
                            <property name="ellipsize">PANGO_ELLIPSIZE_NONE</property>
                            <property name="vexpand">True</property>
                            <property name="hexpand">False</property>
                            <property name="wrap">True</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="justify">center</property>
                            <property name="xalign">0.5</property>
                            <property name="margin-top">10</property>
                            <property name="margin-bottom">10</property>
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="width-chars">64</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="margin-start">18</property>
            <property name="margin-end">18</property>
            <property name="margin-top">18</property>
            <property name="margin-bottom">18</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">18</property>
            <property name="hexpand">True</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <signal name="clicked" handler="handle_cancel" swapped="true"/>
                <property name="label" translatable="yes">Cancel</property>
                <property name="can-shrink">True</property>
                <property name="height-request">50</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="confirm_button">
                <signal name="clicked" handler="handle_confirm" swapped="true"/>
                <property name="label" translatable="yes">Accept &amp; Pair</property>
                <property name="can-shrink">True</property>
                <property name="height-request">50</property>
                <property name="hexpand">True</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
